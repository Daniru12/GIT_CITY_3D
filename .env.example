# Copy to .env — never commit real secrets.
NODE_ENV=development

# URLs
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000
API_PORT=4000
REALTIME_PORT=4001

# Postgres / Redis (match docker-compose.yml)
DATABASE_URL=postgresql://gitcity:gitcity@localhost:5432/gitcity?schema=public
REDIS_URL=redis://localhost:6379

# GitHub OAuth App — create at https://github.com/settings/developers
# Callback URL must be: http://localhost:4000/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 32-byte hex key used to encrypt stored GitHub tokens (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=

# Optional
SENTRY_DSN=
